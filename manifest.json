{
  "manifest_version": 3,
  "name": "Cloud Console Colorize",
  "version": "1.0",
  "description": "Colorize your cloud provider web console",
  "permissions": [
    "activeTab",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "*://console.cloud.google.com/*"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "64": "icons/icon.svg",
      "128": "icons/icon.svg"
    },
    "default_title": "Cloud Console Colorize",
    "default_area": "navbar"
  },
  "background": {
    "scripts": [ "background.js" ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://console.cloud.google.com/*"
      ],
      "js": [
        "gcp.js"
      ]
    }
  ]
}
